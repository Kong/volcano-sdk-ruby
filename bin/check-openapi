#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
expected="$repo_root/lib/volcano/generated"
temporary=$(mktemp -d "${TMPDIR:-/tmp}/volcano-ruby-openapi.XXXXXX")
trap 'rm -rf "$temporary"' EXIT

"$repo_root/bin/generate-openapi" "$temporary/generated" >/dev/null

if ! diff -qr "$expected" "$temporary/generated"; then
  echo "generated OpenAPI boundary is out of date" >&2
  exit 1
fi

actual_digest=$(ruby -rdigest -e 'puts Digest::SHA256.file(ARGV.fetch(0)).hexdigest' "$repo_root/openapi/openapi.yaml")
if [[ "$(tr -d '[:space:]' < "$repo_root/openapi/openapi.yaml.sha256")" != "$actual_digest" ]]; then
  echo "openapi/openapi.yaml.sha256 is out of date; run bin/generate-openapi" >&2
  exit 1
fi

echo "generated OpenAPI boundary is up to date"
