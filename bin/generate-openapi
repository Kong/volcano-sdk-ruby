#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
committed_output="$repo_root/lib/volcano/generated"
if (( $# == 0 )); then
  output="$committed_output"
else
  output=$1
fi

if ! command -v java >/dev/null 2>&1 || ! java -version >/dev/null 2>&1; then
  echo "OpenAPI generation requires a working Java runtime on PATH" >&2
  exit 1
fi

if [[ "$output" == "$committed_output" ]]; then
  mkdir -p "$output"
  find "$output" -mindepth 1 -delete
else
  output_parent=${output%/*}
  output_name=${output##*/}
  if [[ "$output_parent" == "$output" ]]; then
    output_parent=.
  elif [[ -z "$output_parent" ]]; then
    output_parent=/
  fi

  if [[ -z "$output_name" || "$output_name" == "." || "$output_name" == ".." || ! -d "$output_parent" ]]; then
    echo "refusing custom generated output; path must be a new direct child of an existing directory: $output" >&2
    exit 1
  fi
  if ! mkdir -- "$output"; then
    echo "refusing existing custom generated output path: $output" >&2
    exit 1
  fi
fi

cd "$repo_root"
# Project.plan is response-only. Older Hosting releases still return FREE/PRO.
# Keep the vendored producer contract exact and widen only this consumer model.
consumer_spec=$(mktemp "${TMPDIR:-/tmp}/volcano-ruby-contract.XXXXXX.json")
trap 'rm -f "$consumer_spec"' EXIT
ruby -ryaml -rjson -e '
  contract = YAML.safe_load(File.read(ARGV.fetch(0)))
  plan = contract.fetch("components").fetch("schemas").fetch("Project").fetch("properties").fetch("plan")
  plan["enum"] = (plan.fetch("enum") + %w[FREE PRO]).uniq
  File.write(ARGV.fetch(1), JSON.generate(contract))
' openapi/openapi.yaml "$consumer_spec"
npx --no-install openapi-generator-cli generate \
  -i "$consumer_spec" \
  -g ruby \
  -c openapi-generator.yaml \
  -t openapi/templates \
  -o "$output" \
  --global-property apiTests=false,modelTests=false,apiDocs=false,modelDocs=false
