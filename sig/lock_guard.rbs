module Volcano
  interface _LeaseStartedAt
    def monotonic: () -> Float
    def wall: () -> Time
  end

  class LockGuard
    EXPIRY_MESSAGE: String
    MAX_EXPIRY_POLL_SECONDS: Float
    UNSAFE_RENEWAL_MESSAGE: String

    attr_reader ttl: Integer

    def initialize: (LockLease lease, ttl: Integer, started_at: _LeaseStartedAt) -> void
    def lease: () -> LockLease
    def lost?: () -> bool
    # The timeout must be a finite real number.
    def wait_lost: (?timeout: Numeric?) -> bool
    def failure: () -> StandardError?
  end
end
