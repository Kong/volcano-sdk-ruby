module Volcano
  type sandbox_selector = { region: String, ?preset: String, ?sandbox_id: String, ?memory_mb: Integer }
  type sandbox_create_options = { region: String, ?preset: String, ?sandbox_id: String, ?memory_mb: Integer, ?max_duration_seconds: Integer, ?idle_timeout_seconds: Integer, ?request_id: String }
  type sandbox_exec_options = { region: String, ?preset: String, ?sandbox_id: String, ?memory_mb: Integer, ?timeout_seconds: Integer, ?environment: Hash[String, String], ?request_id: String }
  type sandbox_command_options = { ?timeout_seconds: Integer, ?environment: Hash[String, String], ?request_id: String }

  class SandboxCommandResult < Data
    attr_reader stdout: String
    attr_reader stderr: String
    attr_reader exit_code: Integer
    attr_reader timed_out: bool
    attr_reader stdout_truncated: bool
    attr_reader stderr_truncated: bool
    def self.new: (stdout: String, stderr: String, exit_code: Integer, timed_out: bool, stdout_truncated: bool, stderr_truncated: bool) -> SandboxCommandResult
    def initialize: (stdout: String, stderr: String, exit_code: Integer, timed_out: bool, stdout_truncated: bool, stderr_truncated: bool) -> void
    def to_h: () -> { stdout: String, stderr: String, exit_code: Integer, timed_out: bool, stdout_truncated: bool, stderr_truncated: bool }
  end

  class SandboxExecutionResult < Data
    attr_reader stdout: String
    attr_reader stderr: String
    attr_reader exit_code: Integer
    attr_reader timed_out: bool
    attr_reader stdout_truncated: bool
    attr_reader stderr_truncated: bool
    attr_reader session_id: String
    attr_reader region: String
    attr_reader duration_ms: Integer
    def self.new: (stdout: String, stderr: String, exit_code: Integer, timed_out: bool, stdout_truncated: bool, stderr_truncated: bool, session_id: String, region: String, duration_ms: Integer) -> SandboxExecutionResult
    def initialize: (stdout: String, stderr: String, exit_code: Integer, timed_out: bool, stdout_truncated: bool, stderr_truncated: bool, session_id: String, region: String, duration_ms: Integer) -> void
    def to_h: () -> { stdout: String, stderr: String, exit_code: Integer, timed_out: bool, stdout_truncated: bool, stderr_truncated: bool, session_id: String, region: String, duration_ms: Integer }
  end

  class SandboxPreset < Data
    attr_reader id: String
    attr_reader memory_mb: Integer
    attr_reader regions: Array[String]
    def self.new: (id: String, memory_mb: Integer, regions: Array[String]) -> SandboxPreset
    def initialize: (id: String, memory_mb: Integer, regions: Array[String]) -> void
    def to_h: () -> { id: String, memory_mb: Integer, regions: Array[String] }
  end

  class SandboxAccess
    attr_reader url: String
    attr_reader token: String
    attr_reader expires_at: Time
    def initialize: (url: String, token: String, expires_at: Time) -> void
    def inspect: () -> String
  end

  class SandboxDeployment < Data
    attr_reader id: String
    attr_reader status: String
    attr_reader created_at: String
    attr_reader updated_at: String
    def self.new: (id: String, status: String, created_at: String, updated_at: String) -> SandboxDeployment
    def initialize: (id: String, status: String, created_at: String, updated_at: String) -> void
  end

  class SandboxDeploymentPage < Data
    attr_reader data: Array[SandboxDeployment]
    attr_reader limit: Integer
    attr_reader has_more: bool
    attr_reader next_cursor: String?
    def self.new: (data: Array[SandboxDeployment], limit: Integer, has_more: bool, next_cursor: String?) -> SandboxDeploymentPage
    def initialize: (data: Array[SandboxDeployment], limit: Integer, has_more: bool, next_cursor: String?) -> void
  end

  class SandboxBuildLog < Data
    attr_reader timestamp: String
    attr_reader message: String
    def self.new: (timestamp: String, message: String) -> SandboxBuildLog
    def initialize: (timestamp: String, message: String) -> void
  end

  class SandboxBuildLogPage < Data
    attr_reader data: Array[SandboxBuildLog]
    attr_reader next_cursor: String?
    def self.new: (data: Array[SandboxBuildLog], next_cursor: String?) -> SandboxBuildLogPage
    def initialize: (data: Array[SandboxBuildLog], next_cursor: String?) -> void
  end

  module SandboxDeployments
    def deploy: (String project_id, String sandbox_id, String source, name: String, ?memory_mb: Integer, ?ports: Array[Integer], ?request_id: String?) -> SandboxDeployment
    def deployments: (String project_id, String sandbox_id, ?cursor: String?) -> SandboxDeploymentPage
    def deployment: (String project_id, String sandbox_id, String deployment_id) -> SandboxDeployment
    def source: (String project_id, String sandbox_id, String deployment_id) -> String
    def logs: (String project_id, String sandbox_id, String deployment_id, region: String, ?cursor: String?, ?limit: Integer) -> SandboxBuildLogPage
    def delete_template: (String project_id, String sandbox_id) -> nil
  end

  class Sandboxes
    include SandboxDeployments
    def inspect: () -> String
    def presets: () -> Array[SandboxPreset]
    def create: (String project_id, region: String, ?preset: String?, ?sandbox_id: String?, ?memory_mb: Integer?, ?max_duration_seconds: Integer?, ?idle_timeout_seconds: Integer?, ?request_id: String?) -> SandboxSession
    def get: (String session_id) -> SandboxSession
    def exec: (String project_id, String command, region: String, ?preset: String?, ?sandbox_id: String?, ?memory_mb: Integer?, ?timeout_seconds: Integer, ?environment: Hash[String, String]?, ?request_id: String?) -> SandboxExecutionResult
    def grant: (String session_id, String auth_user_id, expires_at: (Time | String)) -> nil
    def revoke: (String session_id, String auth_user_id) -> nil
  end

  class SandboxSession
    def inspect: () -> String
    attr_reader id: String
    attr_reader project_id: String
    attr_reader region: String
    attr_reader state: String
    attr_reader expires_at: Time
    attr_reader files: SandboxFiles
    def refresh: () -> SandboxSession
    def suspend: () -> SandboxSession
    def resume: () -> SandboxSession
    def terminate: () -> SandboxSession
    def exec: (String command, ?timeout_seconds: Integer, ?environment: Hash[String, String]?, ?request_id: String?) -> SandboxCommandResult
    def access: (Integer port) -> SandboxAccess
    def use: [T] () { (SandboxSession) -> T } -> T
  end

  class SandboxFiles
    def inspect: () -> String
    def read: (String path) -> String
    def write: (String path, String data) -> nil
  end
end
