module Volcano
  class Storage
    def from: (String bucket) -> StorageBucket
  end

  class StorageBucket
    def upload: (String path, String | IO | StringIO value, ?content_type: String?) -> Hash[String, json_value]
    def download: (String path, ?range: String?) -> String
    def list: (?String prefix, ?limit: Integer?, ?cursor: String?) -> StoragePage
    def remove: (String | Array[String] paths) -> Array[String]
    def move: (String from_path, String to_path) -> StorageObject
    def copy: (String from_path, String to_path) -> StorageObject
    def update_visibility: (String path, public: bool) -> StorageObject

    def create_upload_session: (String path, total_size: Integer, ?content_type: String, ?part_size: Integer?) -> UploadSession
    def upload_part: (String path, session_id: String, part_number: Integer, data: String) -> UploadPart
    def complete_upload_session: (String path, session_id: String) -> StorageObject
    def get_upload_session: (String path, session_id: String) -> UploadSessionStatus
    def abort_upload_session: (String path, session_id: String) -> nil
    def upload_resumable: (String path, String | IO | StringIO value, ?content_type: String, ?part_size: Integer?, ?on_progress: (^(Integer, Integer) -> void)?) -> StorageObject
  end
end
