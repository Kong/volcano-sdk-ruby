module Volcano
  module AuthSessionConstruction
    INCOMPLETE_SESSION: String

    private def build_session: (Object? payload) -> Session
    private def parse_refresh_session: (Object? payload) -> Session
    private def complete_session?: (Session session) -> bool
    private def matching_session_user?: (Session session) -> bool
    private def owned_complete_session: (Object? session) -> Session
    private def owned_session: (access_token: String, refresh_token: String, user_id: String, ?user: session_user_input?) -> Session
    private def required_session_string: (Object? value) -> String
  end

  class Auth
    include AuthSessionConstruction
    INVALID_SIGN_UP_RESULT: String

    def initialize: (_AuthLifecycleClient client, _AuthLifecycleTransport transport, api_url: String) -> void

    private def sign_in_for_generation: (email: String, password: String, generation: Integer) -> Session
    private def sign_in_response: (email: String, password: String) -> Transport::Response
    private def sign_up_response: (email: String, password: String, metadata: session_user_input) -> Transport::Response
    private def build_sign_up_result: (Object? payload) -> SignUpResult
    private def anonymous_signin_response: (session_user_input metadata) -> Transport::Response
    private def anonymous_conversion_response: (String access_token, String email, String password, session_user_input metadata) -> Transport::Response
    private def confirm_email_response: (token: String) -> Transport::Response
    private def resend_confirmation_response: (email: String) -> Transport::Response
    private def reset_password_for_email_response: (email: String) -> Transport::Response
    private def reset_password_response: (token: String, new_password: String) -> Transport::Response
  end
end
