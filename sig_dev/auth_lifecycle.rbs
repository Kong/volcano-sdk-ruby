module Volcano
  type session_binding = [Integer, SessionOperations, Session?]
  type active_session_binding = [Integer, SessionOperations, Session]

  interface _AuthLifecycleClient
    def capture_session: () -> [Integer, Session?]
    def capture_session_binding: () -> session_binding
    def anon_token: () -> String
    def store_session: (Session session, ?event: Symbol?) -> void
    def current_session: () -> Session?
    def subscribe_auth_state_change: () { (Symbol, Session?) -> void } -> AuthSubscription
    def refresh_rejected?: (Integer generation, SessionOperations lineage) -> bool
    def store_session_if_current?: (Session session, Integer generation, ?event: Symbol, ?notifications: Array[Method]?) -> bool
    def clear_session_if_current?: (Integer generation, ?event: Symbol, ?notifications: Array[Method]?, ?lineage: SessionOperations?) -> bool
    def reject_refresh_if_current?: (Integer generation, ?notifications: Array[Method]?) -> bool
    def update_session_user_if_current?: (Hash[String, json_value] user, Integer generation) -> bool
  end

  interface _AuthLifecycleTransport
    def auth_refresh: (authorization: String, refresh_token: String) -> Transport::Response
    def auth_logout: (authorization: String, refresh_token: String) -> Transport::Response
    def auth_get_user: (authorization: String) -> Transport::Response
    def auth_update_user: (authorization: String, password: String?, metadata: Hash[String, json_value]?) -> Transport::Response
    def auth_request_email_change: (authorization: String, new_email: String) -> Transport::Response
    def auth_cancel_email_change: (authorization: String) -> Transport::Response
    def auth_confirm_email_change: (authorization: String, token: String) -> Transport::Response
    def auth_get_my_sessions: (authorization: String, page: Integer, limit: Integer) -> Transport::Response
    def auth_delete_all_my_sessions: (authorization: String) -> Transport::Response
    def auth_delete_my_session: (authorization: String, session_id: String) -> Transport::Response
    def auth_oauth_authorization_url: (anon_key: String, provider: String, redirect_url: String, client_state: String) -> String
    def auth_oauth_exchange: (authorization: String, code: String, redirect_url: String) -> Transport::Response
    def auth_list_oauth_providers: (authorization: String) -> Transport::Response
    def auth_link_oauth_provider: (authorization: String, provider: String) -> Transport::Response
    def auth_unlink_oauth_provider: (authorization: String, provider: String) -> Transport::Response
    def auth_get_oauth_provider_token: (authorization: String, provider: String) -> Transport::Response
    def auth_refresh_oauth_provider_token: (authorization: String, provider: String) -> Transport::Response
    def auth_call_oauth_api: (authorization: String, provider: String, endpoint: String, method: String, body: json_value) -> Transport::Response
    def auth_signup: (authorization: String, email: String, password: String, metadata: session_user_input) -> Transport::Response
    def auth_signin: (authorization: String, email: String, password: String) -> Transport::Response
    def auth_signup_anonymous: (authorization: String, metadata: session_user_input) -> Transport::Response
    def auth_convert_anonymous: (authorization: String, email: String, password: String, metadata: session_user_input) -> Transport::Response
    def auth_confirm_email: (authorization: String, token: String) -> Transport::Response
    def auth_resend_confirmation: (authorization: String, email: String) -> Transport::Response
    def auth_forgot_password: (authorization: String, email: String) -> Transport::Response
    def auth_reset_password: (authorization: String, token: String, new_password: String) -> Transport::Response
  end

  interface _AuthLifecycleHost
    def refresh_response: (String refresh_token) -> Transport::Response
    def parse_refresh_session: (Object? payload) -> Session
    def access_token_session_id: (String access_token) -> String?
    def delete_session_error: (String access_token, String session_id) -> Error::VolcanoError?
  end

  module AuthNotificationDispatch
    private def run_auth_notifications: (Array[Method] notifications) -> void
  end

  module AuthSessionBinding
    @client: _AuthLifecycleClient

    private def owned_session_binding: (session_binding binding) -> active_session_binding
    private def rejected_refresh?: (session_binding binding, session_binding active) -> bool
  end

  module AuthRefresh : Object, _AuthLifecycleHost
    include AuthNotificationDispatch
    include AuthSessionBinding
    @client: _AuthLifecycleClient

    def refresh_session: () -> Session
    def session_request: (?binding: session_binding) { (String) -> Transport::Response } -> Transport::Response
    def session_read: (?binding: session_binding) { (String) -> Transport::Response } -> Transport::Response

    private def retry_session: (active_session_binding binding) -> Session?
    private def validate_read_failure: (active_session_binding binding) -> void
    private def refresh_captured_session: (active_session_binding binding) -> Session
    private def refresh_with_notifications: (active_session_binding binding) -> void
    private def perform_refresh: (active_session_binding binding, Array[Method] notifications) -> Session
    private def refreshed_session: (active_session_binding binding, String refresh_token, Array[Method] notifications) -> Session
    private def parse_and_verify_refresh: (SessionOperations owner, Session current, active_session_binding binding, String refresh_token, Array[Method] notifications) -> Session
    private def verify_refreshed_session: (SessionOperations owner, Session current, Session session) -> void
    private def refresh_payload: (active_session_binding binding, String refresh_token, Array[Method] notifications) -> Object?
  end

  module AuthSignOut : Object, _AuthLifecycleHost
    include AuthNotificationDispatch
    @client: _AuthLifecycleClient
    @transport: _AuthLifecycleTransport

    def sign_out: () -> Object?

    private def sign_out_captured: (session_binding binding, Session session, SessionOperations::Outcome? preceding, bool? pending, Array[Method] notifications) -> nil
    private def revocation_credentials: (SessionOperations owner, Session session, SessionOperations::Outcome? preceding) -> [Session, Error::VolcanoError?]
    private def logout_response: (String refresh_token) -> Transport::Response
    private def revocation_error: (Session session, SessionOperations owner, Error::VolcanoError? refresh_error, joined: bool?) -> Error::VolcanoError?
    private def refresh_revocation_error: (Session session, Error::VolcanoError? refresh_error, verified: bool?) -> Error::VolcanoError?
    private def revoke_refresh_session: (String? refresh_token) -> nil
    private def revoke_access_session: (Session session, String session_id, Error::VolcanoError? refresh_error, joined: bool?) -> Error::VolcanoError?
    private def refreshable_revocation_token: (Error::VolcanoError? error, Session session) -> String?
  end

  class Auth
    include _AuthLifecycleHost
    include AuthRefresh
    include AuthSignOut
  end
end
