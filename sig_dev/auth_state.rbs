module Volcano
  class AuthSubscription
    @unsubscribe: (^() -> void)?
    @mutex: Mutex
  end

  module SessionCredentials
    def self.validate_refresh: (Session? current, Session? refreshed) -> void
    def self.with_user: (Session session, Hash[String, json_value] user) -> Session
    def self.build: (Object? access_token, Object? refresh_token) -> Session?
    def self.credential: (Object value, Symbol name) -> String
    def self.validate_refresh_source: (Session current, ?verified: bool?) -> void
    def self.validate_refresh_session_id: (Session current, Session? refreshed) -> void
    def self.session_id: (Object? access_token) -> String?
    def self.token_payload: (Object? access_token) -> Object?
  end

  module AuthStateNotifications
    @mutex: Mutex
    @session: Session?
    @callbacks: Hash[Integer, ^(Symbol, Session?) -> void]
    @next_callback_id: Integer
    @notifications: Array[[Array[Integer], Symbol, Session?]]
    @dispatching_notifications: bool

    CALLBACK_FAILURE: singleton(Exception)

    private def register: (^(Symbol, Session?) -> void callback) -> [Integer, Session?]
    private def unsubscribe: (Integer callback_id) -> (^(Symbol, Session?) -> void)?
    private def enqueue_notification: (Array[Integer] callbacks, Symbol? event, Session? session) -> bool
    private def drain_notifications: () -> void
    private def next_notification: () -> [Array[Integer], Symbol, Session?]?
    private def notify: (Array[Integer] callback_ids, Symbol event, Session? session) -> Exception?
  end

  class AuthState
    include AuthStateNotifications

    @mutex: Mutex
    @generation: Integer
    @lineage: SessionOperations
    @session: Session?
    @rejected_refresh: [Integer, SessionOperations]?
    @callbacks: Hash[Integer, ^(Symbol, Session?) -> void]
    @next_callback_id: Integer
    @notifications: Array[[Array[Integer], Symbol, Session?]]
    @dispatching_notifications: bool

    def initialize: (?session: Session?) -> void
    def current: () -> Session?
    def capture: () -> [Integer, Session?]
    def capture_binding: () -> [Integer, SessionOperations, Session?]
    def store: (Session? session, ?event: Symbol) -> void
    def store_if_current?: (Session? session, Integer generation, ?event: Symbol, ?notifications: Array[Method]?, ?lineage: SessionOperations?) -> bool
    def reject_refresh_if_current?: (Integer generation, ?notifications: Array[Method]?) -> bool
    def refresh_rejected?: (Integer generation, SessionOperations lineage) -> bool
    def update_user_if_current?: (Hash[String, json_value] user, Integer generation) -> bool
    def subscribe: () { (Symbol, Session?) -> void } -> AuthSubscription

    private def current_binding?: (Integer generation, SessionOperations? lineage) -> bool
    private def dispatch_notifications: (Array[Method]? queue) -> void
    private def replace: (Session? session, Symbol event, ?verified_pair: Session?) -> Array[Integer]
  end
end
