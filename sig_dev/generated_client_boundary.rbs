    end

    class AuthRefreshRequest < ApiModelBase
      def initialize: ({ refresh_token: String } attributes) -> void
    end

    class AuthRequestEmailChangeRequest < ApiModelBase
      def initialize: ({ new_email: String } attributes) -> void
    end

    class AuthResetPasswordRequest < ApiModelBase
      def initialize: ({ token: String, new_password: String } attributes) -> void
    end

    class AuthSigninRequest < ApiModelBase
      def initialize: ({ email: String, password: String } attributes) -> void
    end

    class AuthSignupAnonymousRequest < ApiModelBase
      def initialize: ({ user_metadata: session_user_input } attributes) -> void
    end

    class AuthSignupRequest < ApiModelBase
      def initialize: ({ email: String, password: String, user_metadata: session_user_input } attributes) -> void
    end

    class AuthUpdateUserRequest < ApiModelBase
      def initialize: (?Hash[Symbol, Object?] attributes) -> void
    end

    class CallOAuthProviderAPIRequest < ApiModelBase
      def initialize: ({ endpoint: String, method: String, body: json_value } attributes) -> void
    end

    class CreateUploadSessionRequest < ApiModelBase
      def initialize: (?Hash[Symbol, Object?] attributes) -> void
    end

    class DatabaseDeleteRequest < ApiModelBase
      def initialize: (Hash[Symbol, sdk_json] attributes) -> void
    end

    class DatabaseInsertRequest < ApiModelBase
      def initialize: (Hash[Symbol, sdk_json] attributes) -> void
    end

    class DatabaseSelectRequest < ApiModelBase
      def initialize: (Hash[Symbol, sdk_json] attributes) -> void
    end

    class DatabaseUpdateRequest < ApiModelBase
      def initialize: (Hash[Symbol, sdk_json] attributes) -> void
    end

    class FunctionInvocationRequest < ApiModelBase
      def initialize: ({ payload: sdk_payload } attributes) -> void
    end

    class LogActivityRequest < ApiModelBase
      def initialize: (Hash[Symbol, sdk_json] attributes) -> void
    end

    class LogSearchRequest < ApiModelBase
      def initialize: (Hash[Symbol, sdk_json] attributes) -> void
    end

    class ProjectLockLeaseRequest < ApiModelBase
      def initialize: ({ ttl_seconds: Integer } attributes) -> void
