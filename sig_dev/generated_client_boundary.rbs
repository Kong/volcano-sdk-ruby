module Volcano
  module Generated
    type api_result = [Object?, Integer, Hash[String, String]?]
    type api_options = Hash[Symbol, Object?]

    class ApiError < StandardError
      attr_reader code: (Integer | String)?
      attr_reader response_body: String?
      attr_reader response_headers: Hash[String, String]?
    end

    class ApiModelBase
      def self._deserialize: (String type, Object? value) -> Object?
    end

    class Configuration
      attr_accessor scheme: String?
      attr_accessor host: String?
      attr_accessor base_path: String
      attr_accessor ignore_operation_servers: bool
      attr_accessor access_token: String?
      attr_accessor timeout: Integer
      def initialize: () -> void
    end

    class ApiClient
      def initialize: (?Configuration config) -> void
      def self.default: () -> ApiClient
      def call_api: (Symbol http_method, String path, ?api_options opts) -> api_result
      def build_request: (Symbol http_method, String path, ?api_options opts) -> Typhoeus::Request
      def select_header_content_type: (Array[String] content_types) -> String
      def convert_to_type: (Object? data, String return_type) -> Object?
      def object_to_http_body: (Object? model) -> Object?
    end

    class AuthConfirmEmailChangeRequest < ApiModelBase
      def initialize: ({ email_change_token: String } attributes) -> void
    end

    class AuthConfirmEmailRequest < ApiModelBase
      def initialize: ({ token: String } attributes) -> void
    end

    class AuthForgotPasswordRequest < ApiModelBase
      def initialize: ({ email: String } attributes) -> void
    end

    class AuthOAuthExchangeRequest < ApiModelBase
