module Volcano
  # Preserves function-owned response bodies through the generated transport.
  class GeneratedTransport
    def resolve_function_for_invocation: (authorization: String, name: String) -> Transport::Response

    def invoke_function: (authorization: String, function_id: String, payload: sdk_payload) -> Transport::Response

    def invoke_function_url: (authorization: String, invoke_url: String, payload: sdk_payload) -> Transport::Response

    private

    def resolve_body: (Object? body) -> Object?

    # The resolved endpoint is absolute and off the API host, so it cannot go
    # through the generated client's configured base URL. The body still uses
    # the invoke contract's { payload } envelope.
    def function_url_response: (String authorization, String invoke_url, sdk_payload payload) -> [String, Integer, Hash[String, String]]

    def function_http_response: (String authorization, String function_id, sdk_payload payload) -> Generated::api_result

    def function_body: (Object? body, Hash[String, String]? headers) -> Object?

    def normalized_function_text: (Object? body) -> String?

    def parse_function_json: (String text) -> Object?

    def valid_function_encoding?: (Object? value) -> bool

    def valid_function_hash_encoding?: (Hash[Object?, Object?] value) -> bool

    def function_json?: (String text, Hash[String, String]? headers) -> bool
  end
end

