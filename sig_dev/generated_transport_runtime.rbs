# Public namespace for the Volcano Ruby SDK.
module Volcano
  type generated_storage_options = Hash[Symbol, Symbol | Hash[String, String] | Array[String] | String]
  type generated_storage_delete_options = Hash[Symbol, Symbol | Hash[String, String] | Array[String]]
  # Adapts the generated OpenAPI client to the stable SDK transport contract.
  class GeneratedTransport
    @api_url: String

    @timeout: Integer | Float

    @api_factory: ^(String) -> GeneratedApis

    include ApiFactory


    include ValueNormalization

    class GeneratedApis < Data
      attr_reader authentication: Generated::AuthenticationApi
      attr_reader oauth: Generated::OAuthAuthenticationApi
      attr_reader database: Generated::DatabaseQueriesApi
      attr_reader storage: StorageApi
      attr_reader locks: Generated::LocksApi
      attr_reader functions: Generated::FunctionsApi
      attr_reader durable: Generated::DurableFunctionsApi
      attr_reader logs: Generated::LogsApi

      def self.new: (authentication: Generated::AuthenticationApi, oauth: Generated::OAuthAuthenticationApi, database: Generated::DatabaseQueriesApi, storage: StorageApi, locks: Generated::LocksApi, functions: Generated::FunctionsApi, durable: Generated::DurableFunctionsApi, logs: Generated::LogsApi) -> GeneratedApis
    end

    def initialize: (api_url: String, ?timeout: (Integer | Float), ?api_factory: (^(String) -> GeneratedApis)?) -> void

    def acquire_project_lock: (authorization: String, key: String, ttl: Integer, token: String, ?request_id: String) -> Transport::Response

    def get_project_lock: (authorization: String, key: String, ?request_id: String) -> Transport::Response

    def force_release_project_lock: (authorization: String, key: String, ?request_id: String) -> Transport::Response

    def renew_project_lock: (authorization: String, key: String, ttl: Integer, token: String, ?request_id: String) -> Transport::Response

    def release_project_lock: (authorization: String, key: String, token: String, ?request_id: String) -> Transport::Response

    private

    def invoke: [T] () { () -> T } -> (T | Transport::Response)

    def error_status: (Generated::ApiError error) -> Integer

    def response: (Object? data, Integer status, Hash[String, String]? headers, ?binary: String?) -> Transport::Response
  end
end

