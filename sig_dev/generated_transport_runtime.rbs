module Volcano
  # Internal transport implementation assembled across support modules.
  interface _GeneratedModelDeserializer
    def _deserialize: (String type, Object? value) -> Object?
  end

  class GeneratedTransport
    # Resolves generated model constants across the private namespace boundary.
    module ModelDeserialization : _GeneratedModelDeserializer
      def _deserialize: (String type, Object? value) -> Object?

      private

      def deserialize_private_model: (Object? klass, Object? value) -> Object?
    end

    # Corrects generated content negotiation and private model lookup.
    class ApiClient < Generated::ApiClient
      def build_request: (Symbol http_method, String path, ?Generated::api_options options) -> Typhoeus::Request

      def select_header_content_type: (Array[String] content_types) -> String?

      def convert_to_type: (Object? data, String return_type) -> Object?
    end

    # Captures a generated request URL without performing network I/O.
    class AuthorizationURLApiClient < ApiClient
      def call_api: (Symbol http_method, String path, ?Generated::api_options options) -> [String, Integer, Hash[String, String]]
    end

    # Implements storage endpoints omitted by the generated API surface.
    class StorageApi < Generated::StorageObjectsApi
      DOWNLOAD_HEADERS: Hash[String, String]
      UPLOAD_OPTIONS: generated_storage_options

      DOWNLOAD_OPTIONS: generated_storage_options

      DELETE_OPTIONS: generated_storage_delete_options

      VISIBILITY_OPTIONS: generated_storage_options

      def upload_storage_object_with_http_info: (String bucket_name, String path, File file, ?Generated::api_options opts) -> Generated::api_result

      def download_storage_object_with_http_info: (String bucket_name, String path, ?Generated::api_options opts) -> Generated::api_result

      def delete_storage_object_with_http_info: (String bucket_name, String path, ?Generated::api_options opts) -> Generated::api_result

      def update_storage_object_visibility_with_http_info: (String bucket_name, String path, Object request, ?Generated::api_options opts) -> Generated::api_result

      private

      def call_storage_api: (Symbol method, String? bucket_name, String? path, Generated::api_options options, ?suffix: String) -> Generated::api_result
    end

    # Normalizes values returned by the generated client.
    module ValueNormalization
      private

      def parse_body: (Object? value) -> Object?

      def plain_value: (Object? value) -> Object?

      def plain_hash: (Hash[Object?, Object?] value) -> Hash[String, Object?]

      def deep_symbolize: (sdk_payload value) -> Hash[Symbol, sdk_json]
      def deep_symbolize_value: (sdk_json value) -> sdk_json

      def binary_data: (Object? value) -> String

      def prepare_stream: (Object? value) -> Object?

      def reopen_stream: (Object? value) -> (Object? | nil)
    end

    # Builds generated API wrappers with consistent authentication and timeouts.
    module ApiFactory
      @api_url: String
      @timeout: Integer | Float

      private

      def build_apis: (String authorization) -> GeneratedApis

      def generated_configuration: (String? authorization) -> Generated::Configuration

      def timeout_milliseconds: () -> Integer

      def generated_apis: (ApiClient api_client) -> GeneratedApis

      def oauth_authorization_api: () -> Generated::OAuthAuthenticationApi

      def host_with_port: (URI::Generic uri) -> String
    end
  end
end

module Volcano
  # Corrects generated HTTP operations for resumable storage uploads.
  class GeneratedTransport::StorageApi
    UPLOAD_PART_HEADERS: Hash[String, String]
    COMPLETE_HEADERS: Hash[String, String]
    STATUS_HEADERS: Hash[String, String]
    ABORT_HEADERS: Hash[String, String]
    CREATE_OPTIONS: generated_storage_options

    UPLOAD_PART_OPTIONS: generated_storage_options

    COMPLETE_OPTIONS: generated_storage_options

    STATUS_OPTIONS: generated_storage_options

    ABORT_OPTIONS: generated_storage_delete_options

    def create_upload_session_with_http_info: (String bucket_name, String path, Generated::CreateUploadSessionRequest request) -> Generated::api_result

    def upload_part_with_http_info: (String bucket_name, String path, String session_id, Integer part_number, String data) -> Generated::api_result

    def complete_upload_session_with_http_info: (String bucket_name, String path, String session_id) -> Generated::api_result

    def get_upload_session_with_http_info: (String bucket_name, String path, String session_id) -> Generated::api_result

    def abort_upload_session_with_http_info: (String bucket_name, String path, String session_id) -> Generated::api_result
  end
end

