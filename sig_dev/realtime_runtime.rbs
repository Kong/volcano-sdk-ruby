module Volcano
  class Realtime
    class ClosedError < StandardError
    end

    class DuplicateSubscriptionError < StandardError
    end

    class PendingLimitError < StandardError
    end

    class RequestTimeoutError < StandardError
    end

    # Implements the Centrifuge request and publication protocol.
    class Protocol
      interface _DispatchContext
        def write_frame: (Hash[String, Object?] frame) -> void
        def dispatch_publication: (Hash[String, Object?] push) -> void
        def dispatch_queued_callback: (Object delivery) -> void
        def close_with: (StandardError error, ?notify_error: bool) -> void
        def closed_error: (StandardError error) -> ClosedError
      end

      interface _LifecycleContext
        def ensure_open!: () -> self
        def initialize_recovery_positions: () -> void
        def initialize_publication_producer: () -> void
        def dispatch_callbacks: () -> void
        def dispatch_publication_batches: () -> void
        def read_loop: () -> void
      end

      interface _PublicationContext
        def enqueue_live_publication: (ProtocolPublicationDispatch::PublicationDelivery delivery) -> void
        def matching_channel: [T] (Hash[String, T] handlers, String channel) -> String?
        def drop_publication: (String channel, Object? publication) -> void
        def mark_unknown_gap: (String channel) -> void
        def dispatch_callback_delivery: (Array[^(String, Object?) -> void] handlers, String event, Object? data) -> void
      end

      interface _IOContext
        def ensure_open!: () -> self
        def close_with: (StandardError error, ?notify_error: bool) -> void
        def process: (Hash[String, Object?] frame) -> void
      end

      class Failure < Data
        attr_reader error: StandardError
        def self.new: (error: StandardError) -> Failure
        def initialize: (error: StandardError) -> void
      end

      class Pending < Data
        attr_reader queue: Async::Queue[Object?]
        attr_reader on_reply: (^(Object?) -> void)?
        attr_reader reply_key: String
        def self.new: (queue: Async::Queue[Object?], on_reply: (^(Object?) -> void)?, reply_key: String) -> Pending
        def initialize: (queue: Async::Queue[Object?], on_reply: (^(Object?) -> void)?, reply_key: String) -> void
      end

      class Events < Data
        attr_reader on_close: (^(Exception) -> void)?
        attr_reader on_error: (^(Exception) -> void)?
        attr_reader on_failure: (^(Exception, bool) -> void)?
        def self.new: (on_close: (^(Exception) -> void)?, on_error: (^(Exception) -> void)?, on_failure: (^(Exception, bool) -> void)?) -> Events
        def initialize: (on_close: (^(Exception) -> void)?, on_error: (^(Exception) -> void)?, on_failure: (^(Exception, bool) -> void)?) -> void
      end

      @socket: _RealtimeSocket

      @secrets: Array[String?]

      @events: Events?

      @connected: bool

      @request_timeout: Numeric

      @max_pending: Integer

      @max_callback_queue: Integer

      @subscription_lock: Async::Semaphore
      @subscriptions: Set[String]
      @closed: bool
      @closed_error: StandardError?

      include ProtocolDispatch

      include Lifecycle

      include ProtocolPublicationDispatch

      include ProtocolRecovery

      include ProtocolRecoveryDispatch

      include ProtocolRecoveryPosition


      DEFAULT_REQUEST_TIMEOUT: 10

      DEFAULT_MAX_PENDING: 128

      DEFAULT_MAX_CALLBACK_QUEUE: 128

      LIMIT_KEYS: Array[Symbol]

      def self.connect: (id: Integer, token: String) -> Hash[String, Object]

      def self.subscribe: (id: Integer, channel: String, ?recoverable: bool, ?join_leave: bool, ?recovery: Hash[Symbol, String | Integer]?) -> Hash[String, Object]

      def self.add_recovery_options: (Hash[String, Object] options, Hash[Symbol, String | Integer] recovery) -> void

      def self.publish: (id: Integer, channel: String, data: Object) -> Hash[String, Object]

      def self.unsubscribe: (id: Integer, channel: String) -> Hash[String, Object]

      def self.presence: (id: Integer, channel: String) -> Hash[String, Object]

      def initialize: (socket: _RealtimeSocket, ?task: Async::Task?, ?secrets: Array[String?], ?events: Events?, **Integer limits) -> void

      def connect: (token: String) -> Hash[String, Object]

      def subscribe: (channel: String, ?recoverable: bool, ?join_leave: bool, ?recovery: Hash[Symbol, String | Integer]?) -> Object?

      def publish: (channel: String, data: Object) -> Object?

      def unsubscribe: (channel: String) -> Object?

      def presence: (channel: String) -> Object?

      def __send__: (:position method_name, String channel) -> Hash[Symbol, String | Integer]?
                    | (:drop_publication method_name, String channel, Object? publication) -> void
                    | (:complete_publication method_name, String channel, Object? publication) -> void
                    | (:delete_recovery_state method_name, String channel) -> void

      def close: () -> nil

      private

      def load_async: () -> Object

      def configure_limits: (Hash[Symbol, Integer] limits) -> void

      def ensure_open!: () -> self
    end
  end
end

module Volcano
  class Realtime
    # Dispatches protocol replies and publications to their waiting consumers.
    module ProtocolDispatch
      include Protocol::_DispatchContext
      class PresenceDelivery < Data
        attr_reader handlers: Array[^(String, Object?) -> void]
        attr_reader event: String
        attr_reader data: Hash[String, Object?]
        def self.new: (handlers: Array[^(String, Object?) -> void], event: String, data: Hash[String, Object?]) -> PresenceDelivery
      end

      @pending: Hash[Integer, Protocol::Pending]
      @presence_handlers: Hash[String, Array[^(String, Object?) -> void]]
      @pending_presence_resyncs: Hash[String, Array[^(String, Object?) -> void]]
      @callback_queue: Async::LimitedQueue[Object]
      @max_callback_queue: Integer
      @callback_stopping: bool

      private

      def process: (Hash[String, Object?] frame) -> void

      def dispatch_push: (Hash[String, Object?] push) -> void

      def dispatch_reply: (Hash[String, Object?] frame) -> void

      def apply_reply_hook: (Protocol::Pending pending, Object? reply) -> Object?

      def reply_value: (Hash[String, Object?] frame, String reply_key) -> Object?

      def successful_reply: (Hash[String, Object?] frame, String reply_key) -> Object?

      def dispatch_presence: (Hash[String, Object?] push, String event) -> void

      def matching_channel: [T] (Hash[String, T] handlers, String channel) -> String?

      def postgres_channel?: (String candidate, String channel) -> bool

      def dispatch_callbacks: () -> void

      def dispatch_callback_delivery: (Array[^(String, Object?) -> void] handlers, String event, Object? data) -> void

      def enqueue_pending_presence_resync: () -> void
    end
  end
end

module Volcano
  class Realtime
    # Centrifuge protocol implementation extended with socket IO helpers.
    class Protocol
      # Coordinates protocol requests and the socket reader loop.
      module IO
        include _IOContext
        @next_id: Integer
        @pending: Hash[Integer, Pending]
        @max_pending: Integer
        @secrets: Array[String?]
        @write_lock: Async::Semaphore
        @socket: _RealtimeSocket
        @request_timeout: Numeric

        private

        def request: (String reply_key, ?on_reply: (^(Object?) -> void)?) { (Integer) -> Hash[String, Object] } -> Object?

        def register_request: (String reply_key, (^(Object?) -> void)? on_reply) -> [Integer, Async::Queue[Object?]]

        def write_frame: (Hash[String, Object] frame) -> void

        def write_serialized_frame: (String frame) -> void

        def await_reply: (Async::Queue[Object?] reply_queue) -> Object?

        def read_loop: () -> void

        def read_message: () -> _RealtimeFrame?

        def process_message: (_RealtimeFrame message) -> void

        def invalid_frame_message: (StandardError error) -> String

        def closed_error: (StandardError error) -> ClosedError
      end

      include IO
    end
  end
end

module Volcano
  class Realtime
    class Protocol
      # Exposes connection state and manages publication handlers.
      module Lifecycle
        include _LifecycleContext
        @next_id: Integer
        @pending: Hash[Integer, Pending]
        @callback_stopping: bool
        @subscriptions: Set[String]
        @closed_error: StandardError?
        @write_lock: Async::Semaphore
        @subscription_lock: Async::Semaphore
        @publication_handlers: Hash[String, Array[ProtocolPublicationDispatch::Registration]]
        @presence_handlers: Hash[String, Array[^(String, Object?) -> void]]
        @pending_presence_resyncs: Hash[String, Array[^(String, Object?) -> void]]
        @callback_queue: Async::LimitedQueue[Object]
        @callback_task: Async::Task?
        @producer_task: Async::Task?
        @reader_task: Async::Task?
        @producer_stopping: bool
        @connected: bool
        @closed: bool
        @events: Events?
        @socket: _RealtimeSocket
        @max_callback_queue: Integer

        def connected?: () -> bool

        def on_publication: (String channel, ?on_rejection: (^(Object?) -> void)?) { (Object?, Object?, Object?, recovered: bool) -> void } -> ^(Object?, Object?, Object?, recovered: bool) -> void

        def off_publication: (String channel, ^(Object?, Object?, Object?, recovered: bool) -> void handler) -> nil

        def on_presence: (String channel) { (String, Object?) -> void } -> ^(String, Object?) -> void

        def off_presence: (String channel, ^(String, Object?) -> void handler) -> nil

        private

        def initialize_state: () -> void

        def initialize_locks: () -> void

        def initialize_handlers: () -> void

        def start_tasks: (Async::Task task) -> void

        def reject_pending: (StandardError error) -> void

        def close_socket: () -> void

        def stop_protocol_tasks: () -> void

        def close_with: (StandardError error, ?notify_error: bool) -> void

        def close_state: (StandardError error) -> void

        def stop_protocol: (StandardError error) -> void

        def notify_protocol_error: (StandardError error) -> void

        def notify_protocol_failure: (StandardError error, bool disconnected) -> void

        def notify_protocol_close: (StandardError error) -> void
      end
    end
  end
end

module Volcano
  class Realtime
    # Normalizes publications and admits live deliveries without blocking the reader.
    module ProtocolPublicationDispatch
      include Protocol::_PublicationContext
      class Registration < Data
        attr_reader handler: ^(Object?, Object?, Object?, recovered: bool) -> void
        attr_reader on_rejection: (^(Object?) -> void)?
        def self.new: (handler: ^(Object?, Object?, Object?, recovered: bool) -> void, on_rejection: (^(Object?) -> void)?) -> Registration
      end

      @publication_handlers: Hash[String, Array[Registration]]
      @stream_positions: Hash[String, ProtocolRecoveryPosition::position]
      @callback_queue: Async::LimitedQueue[Object]
      @callback_stopping: bool

      private

      def dispatch_publication: (Hash[String, Object?] push) -> void

      def publication_delivery: (String channel, Object? publication, recovered: bool) -> PublicationDelivery?

      def matching_publication_channel: (String channel) -> String?

      def reject_invalid_publication: (String channel, Object? publication) -> nil

      def drop_handlerless_publication: (String channel, Object? publication) -> nil

      def build_publication_delivery: (String channel, Hash[String, Object?] publication, Hash[String, Object?] data, recovered: bool) -> PublicationDelivery

      def combined_rejection_hook: (Array[Registration] registrations) -> (^(Object?) -> void)?

      def admit_live_publication: (PublicationDelivery delivery) -> void

      def callback_queue_full?: () -> bool

      def reject_publication_delivery: (PublicationDelivery delivery) -> void

      def dispatch_queued_callback: (Object delivery) -> void

      def dispatch_publication_callbacks: (PublicationDelivery delivery) -> void
    end
  end
end

module Volcano
  class Realtime
    # Reconnects unexpected transport losses and restores subscription intent.
    module Reconnect
      include _ReconnectContext
      include _ChannelErrorContext
      @closed: bool
      @reconnect_task: Async::Task?
      @reconnect_delay: ^(Integer) -> Numeric
      @protocol: Protocol?
      @channels: Hash[String, Channel]

      RECONNECT_MIN_DELAY: ::Float

      RECONNECT_MAX_DELAY: ::Float

      MAX_BACKOFF_EXPONENT: Integer

      private

      def start_reconnect: () -> void

      def stop_reconnect: () -> void

      def reconnect_loop: () -> void

      def reconnect_attempt_finished?: (Integer attempt) -> bool

      def wait_before_reconnect: (Integer attempt) -> void

      def current_or_connect_protocol: () -> Protocol?

      def restore_subscriptions: (Protocol protocol) -> void

      def subscriptions_restored?: (Protocol protocol) -> bool

      def channels_snapshot: () -> Array[Channel]

      def reconnect_needed?: () -> bool

      def default_reconnect_delay: (Integer attempt) -> Float
    end
  end
end
