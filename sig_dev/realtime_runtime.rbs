      def update_presence_state: (String event, PresenceInfo snapshot) -> void
      def presence_info: (Hash[String, Object?] info, Object? fallback_client) -> PresenceInfo
      def clear_presence: () -> Hash[String, PresenceInfo]?
      def reset_presence: () -> void
    end
  end
