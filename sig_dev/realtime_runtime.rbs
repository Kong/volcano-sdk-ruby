      @channels: Hash[String, Channel]

      def connected?: () -> bool

      def remove_channel: (String name, ?type: String | Symbol) -> nil

      def remove_all_channels: () -> nil

      private

      def remove_channel_locked: (String name) -> Channel?

      def remove_channel_entry: (String name, Channel channel) -> StandardError?
    end
  end
