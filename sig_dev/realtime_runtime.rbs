      def valid_postgres_payload?: (Hash[String, Object?] data) -> bool
      def optional_hash?: (Object? value) -> bool
      def optional_array?: (Object? value) -> bool
      def broadcast?: () -> bool
      def postgres?: () -> bool
      def ensure_postgres!: () -> void
    end
  end
