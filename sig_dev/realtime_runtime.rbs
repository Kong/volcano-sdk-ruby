      def postgres_change: (Object? data) -> PostgresChange?
      def postgres_event: (Object event) -> String
      def register_postgres_listener: (String event, String schema, String table, ^(PostgresChange) -> void handler) -> Channel
      def postgres_listener?: (PostgresChange change) -> bool
      def postgres_filter_matches?: (String event, String schema, String table, PostgresChange change) -> bool
      def valid_postgres_change?: (Object? data) -> bool
