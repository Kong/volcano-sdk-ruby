module Volcano
  interface _RealtimeDatabase
    def from: (String table) -> _RealtimeQuery
  end

  interface _RealtimeQuery
    def select: (String column) -> _RealtimeQuery
    def in: (String column, Array[json_value] ids) -> _RealtimeQuery
    def execute: () -> Object?
  end

  interface _RealtimeClient
    def anon_token: () -> String
    def current_session: () -> Session?
    def capture_session: () -> [Integer, Session?]
    def capture_session_binding: () -> session_binding
    def database_with_token: (String database_name, String access_token) -> _RealtimeDatabase
    def __send__: (:database_with_token, String database_name, String access_token) -> _RealtimeDatabase
  end

  # Manages a project's realtime connection and broadcast channels.
  class Realtime
    @client: _RealtimeClient

    @api_url: String

    @socket_factory: ^(String) -> _RealtimeSocket

    @reconnect_delay: ^(Integer) -> Numeric

    @protocol: Protocol?

    @protocol_lock: Async::Semaphore?

    @channel_lock: Async::Semaphore?

    @channels: Hash[String, Channel]

    @connection_callbacks: Hash[ConnectionCallbacks::connection_event, ConnectionCallbacks::connection_callbacks]

    @next_connection_callback_id: Integer

    @protocol_session_lineage: SessionOperations?

    @reconnect_task: Async::Task?

    @closed: bool

    include Lifecycle

    include ConnectionCallbacks

    include Connection

    include Reconnect

    include PostgresDatabase

    include Core




    # Recursively snapshots JSON-compatible values for callback and state safety.
    module Immutable
      def self.optional: (Object? value) -> Object?

      def self.call: [K, V] (Hash[K, V] value) -> Hash[K, V]
                   | [T] (Array[T] value) -> Array[T]
                   | (String value) -> String
                   | (Object? value) -> Object?

      def self.snapshot: (Object? value) -> Object?

      def self.call_hash: (Hash[Object?, Object?] value) -> Hash[Object?, Object?]
    end


    CHANNEL_TYPES: Array[Symbol]

    class PostgresBatchConfig < Data
      attr_reader auto_fetch: bool
      attr_reader batch_window_ms: Integer
      attr_reader max_batch_size: Integer
      def self.new: (auto_fetch: bool, batch_window_ms: Integer, max_batch_size: Integer) -> PostgresBatchConfig
      def initialize: (auto_fetch: bool, batch_window_ms: Integer, max_batch_size: Integer) -> void
    end

    interface _LifecycleContext
      def channel_lock: () -> Async::Semaphore
      def normalize_channel_type: (String | Symbol type) -> Symbol
    end

    interface _ConnectionContext
      def protocol_connected: (Object result) -> void
      def protocol_error: (Exception error) -> void
      def protocol_closed: (Exception error) -> void
      def protocol_error_started: (Exception error) -> void
      def protocol_failed: (Exception error, bool disconnected) -> void
    end

    interface _ReconnectContext
      def channel_lock: () -> Async::Semaphore
      def protocol_lock: () -> Async::Semaphore
      def connect_protocol: () -> Protocol
    end

    interface _ReconnectStartContext
      def start_reconnect: () -> void
    end

    interface _ReconnectStopContext
      def stop_reconnect: () -> void
    end

    interface _ChannelErrorContext
      def report_channel_error: (StandardError error) -> void
    end

    interface _CoreDependencies
      def initialize_postgres_database: () -> void
      def connect_protocol: () -> Protocol
      def close_protocol: () -> void
      def public_error: (StandardError error) -> Exception
      def protocol_error: (Exception error) -> void
      def open_socket: (String address) -> _RealtimeSocket
      def default_reconnect_delay: (Integer attempt) -> Float
    end

    module Core
      include _CoreDependencies
      @client: _RealtimeClient
      @api_url: String
      @socket_factory: ^(String) -> _RealtimeSocket
      @reconnect_delay: ^(Integer) -> Numeric
      @protocol: Protocol?
      @protocol_lock: Async::Semaphore?
      @channel_lock: Async::Semaphore?
      @channels: Hash[String, Channel]
      @connection_callbacks: Hash[ConnectionCallbacks::connection_event, ConnectionCallbacks::connection_callbacks]
      @next_connection_callback_id: Integer
      @protocol_session_lineage: SessionOperations?
      @reconnect_task: Async::Task?
      @closed: bool

      def initialize: (_RealtimeClient client, api_url: String, ?socket_factory: (^(String) -> _RealtimeSocket)?, ?reconnect_delay: (^(Integer) -> Numeric)?) -> void

      private

      def initialize_realtime_state: () -> Object

      public

      def channel: (String name, ?type: String | Symbol, ?auto_fetch: bool, ?fetch_batch_window_ms: Integer, ?fetch_max_batch_size: Integer) -> Channel

      private

      def protocol: () -> Protocol

      public

      def disconnect: () -> void

      def ensure_open!: () -> self

      def __send__: (:report_channel_error method_name, StandardError error) -> void
                    | (:access_token_for_protocol_lineage method_name, SessionOperations lineage) -> String
                    | (:fetch_postgres_rows method_name, PostgresChange change, Array[json_value] ids, String database_name, String access_token) -> Array[Hash[String, json_value]]
                    | (:capture_protocol_session method_name) -> [Integer, SessionOperations, Session]
                    | (:capture_session_binding method_name) -> session_binding
                    | (:database_name method_name) -> String?

      private

      def normalize_channel_type: (String | Symbol type) -> Symbol

      def report_channel_error: (StandardError error) -> void

      def cached_channel: (Channel channel, PostgresBatchConfig batch_config) -> Channel

      def build_channel: (String name, Symbol type, PostgresBatchConfig batch_config) -> Channel

      def protocol_lock: () -> Async::Semaphore

      def channel_lock: () -> Async::Semaphore

    end

    # Represents one realtime broadcast channel.
    class Channel
      @realtime: Core

      @protocol_provider: ^() -> Protocol

      @name: String

      @handler_registered: bool

      @lifecycle_lock: Async::Semaphore?

      @recovery_position: Hash[Symbol, String | Integer]

      @recovery_lineage: SessionOperations?

      @subscription_desired: bool

      @subscribed: bool

      @closed: bool

      include PostgresChanges

      include BroadcastDelivery

      include PostgresDelivery

      include PostgresExpansion

      include Presence

      include ChannelCallbacks

      include PostgresBatch

      include PresenceState

      include ChannelLifecycle

      def initialize: (Core realtime, ^() -> Protocol protocol_provider, String name, Symbol type, batch_config: PostgresBatchConfig) -> void

      def subscription_desired?: () -> bool

      def restoration_needed?: () -> bool

      def restore_subscription: (Protocol protocol) -> nil

      private

      def remove: () -> nil

      def subscribe_with_intent: () -> [Protocol, Integer]

      def initialize_recovery_state: () -> void

      def with_lifecycle_lock: [T] () { () -> T } -> T

      def ensure_open!: () -> Core
    end
  end
end

