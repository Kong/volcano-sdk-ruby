      @subscribed: bool
      @name: String
      @protocol_provider: ^() -> Protocol
      @realtime: Core

      def on_presence_sync: (?(^(Object?) -> void)? callback) ?{ (Object?) -> void } -> Channel
      def track: (?Hash[String, json_value] state) -> nil
      def presence_state: () -> Hash[String, PresenceInfo]
      def tracked_state: () -> Hash[String, json_value]
      def get_presence_state: () -> Hash[String, PresenceInfo]

      private

      def initialize_presence: (Symbol type) -> void
      def presence?: () -> bool
      def ensure_presence!: () -> void
      def validate_presence_state: (Object state) -> void
      def register_presence_handler: (Protocol protocol, Integer epoch) -> void
      def sync_presence: (Protocol protocol, Integer epoch) -> void
      def fetch_presence_state: (Protocol protocol, Integer epoch) -> Hash[String, PresenceInfo]?
      def presence_event: (String event, Object? info, Integer epoch) -> void
      def emit_presence_sync: (Hash[String, PresenceInfo]? state) -> void
      def report_presence_error: (Protocol protocol, Integer epoch, StandardError error) -> void
      def next_presence_epoch: () -> Integer
      def active_presence_epoch?: (Integer epoch) -> bool
      def invalidate_presence_subscription: (Protocol protocol) -> void
      def detach_presence_handler: (Protocol protocol) -> void
      def presence_lock: () -> Async::Semaphore
    end
  end
end

module Volcano
  class Realtime
    # Maintains immutable presence state independently of protocol lifecycle.
    module PresenceState
      include _PresenceStateContext
