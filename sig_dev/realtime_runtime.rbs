module Volcano
  class Realtime
    # Opens the WebSocket transport and maps its failures to public errors.
    module Connection
      include _ConnectionContext
      include _ReconnectStopContext
      @client: _RealtimeClient
      @api_url: String
      @socket_factory: ^(String) -> _RealtimeSocket
      @channels: Hash[String, Channel]
      @protocol_error_reported: bool

      @protocol: Protocol?

      @protocol_session_lineage: SessionOperations?

      @closed: bool

      @manual_disconnect: bool

      private

      def connect_protocol: () -> Protocol

      def active_session_lineage: () -> SessionOperations

      def session_for_lineage: (SessionOperations expected_lineage) -> Session

      def activate_protocol: (Protocol protocol, SessionOperations session_lineage, Hash[String, Object] result) -> Protocol

      def close_protocol: () -> nil

      def close_connected_protocol: () -> void

      def handle_connection_failure: (_RealtimeSocket? socket, StandardError error) -> bot

      def build_protocol: (_RealtimeSocket socket) -> Protocol

      def close_socket: (_RealtimeSocket? socket) -> void

      def address: () -> String

      def open_socket: (String address) -> _RealtimeSocket

      def realtime_secrets: () -> Array[String?]

      def public_error: (StandardError error) -> Exception
    end
  end
end

module Volcano
  class Realtime
    # Channel collection and connection-state lifecycle operations.
    module Lifecycle
      include _LifecycleContext
