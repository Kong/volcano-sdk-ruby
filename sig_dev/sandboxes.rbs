module Volcano
  type sandbox_request_options = { operation: Symbol, ?resource_id: String, ?subject_id: String, ?body: Hash[Symbol, json_value], ?request_id: String, ?timeout: Integer, ?deployment_id: String, ?archive: String, ?cursor: String?, ?region: String, ?limit: Integer }

  class SandboxRequest
    @options: sandbox_request_options
    attr_reader operation: Symbol
    attr_reader resource_id: String?
    attr_reader subject_id: String?
    attr_reader body: Hash[Symbol, json_value]?
    attr_reader request_id: String?
    attr_reader deployment_id: String?
    attr_reader archive: String
    attr_reader deployment_body: Hash[Symbol, json_value]
    attr_reader cursor: String?
    attr_reader region: String?
    attr_reader limit: Integer?
    attr_reader timeout: Integer
    def initialize: (sandbox_request_options options) -> void
  end

  interface _SandboxTransport
    def sandbox_request: (authorization: String, request: SandboxRequest) -> Transport::Response
  end

  interface _SandboxClient
    def current_session: () -> Session?
    def service_token: () -> String
    def session_request: () { (String) -> Transport::Response } -> Transport::Response
  end

  class SandboxAccess
    @url: String
    @token: String
    @expires_at: Time
  end

  class SandboxRequests
    UUID: Regexp
    USER_OPERATIONS: Array[Symbol]
    @client: _SandboxClient
    @transport: _SandboxTransport
    @service_only: bool
    def initialize: (_SandboxClient client, _SandboxTransport transport, ?service_only: bool) -> void
    def service_scope: () -> SandboxRequests
    private def user_request?: (SandboxRequest request) -> bool
    def self.expiry: ((Time | String) value) -> String
    def call: (SandboxRequest request, ?status: Integer) -> Object?
    private def dispatch: (SandboxRequest request, String token) -> Transport::Response
    def self.identifier: (Object? value) -> String
    def self.request_id: (Hash[Symbol, json_value] options) -> String
    def self.selector: (Hash[Symbol, json_value] options) -> Hash[Symbol, json_value]
    def self.command: (String command, Hash[Symbol, json_value] options) -> Hash[Symbol, json_value]
  end

  module SandboxResponse
    STATES: Array[String]
    def self.timestamp: (Object? value) -> Time
    def self.text: (Object? value) -> String
    def self.integer: (Object? value) -> Integer
    def self.flag: (Object? value) -> bool
    def self.state: (Object? value) -> String
    def self.command: (Object? value) -> SandboxCommandResult
    def self.execution: (Object? value) -> SandboxExecutionResult
    def self.access: (Object? value) -> SandboxAccess
    def self.preset: (Object? value) -> SandboxPreset
    def self.array: (Object? value) -> Array[Object?]
  end

  module SandboxDeploymentResponse
    def self.deployment: (Object? value) -> SandboxDeployment
    def self.page: (Object? value) -> SandboxDeploymentPage
    def self.logs: (Object? value) -> SandboxBuildLogPage
    def self.log: (Object? value) -> SandboxBuildLog
    def self.optional_text: (Object? value) -> String?
  end

  module SandboxDeployments
    @requests: SandboxRequests
    private def deployment_request: (String project_id, String sandbox_id, sandbox_request_options options) -> SandboxRequest
    private def validate_source: (String source, Array[Integer] ports) -> void
    private def validate_ports: (Array[Integer] ports) -> void
    private def valid_port?: (Integer port) -> bool
  end

  class Sandboxes
    @requests: SandboxRequests
    def initialize: (_SandboxClient client, _SandboxTransport transport) -> void
  end

  class SandboxSession
    @requests: SandboxRequests
    def initialize: (SandboxRequests requests, Object? value) -> void
    private def cleanup: (bool unwinding) -> (SandboxSession | nil)
    private def update: (Symbol operation, ?status: Integer) -> SandboxSession
    private def assign_state: (Hash[String, json_value] data) -> void
  end

  class SandboxFiles
    FILE_LIMIT: Integer
    @requests: SandboxRequests
    @session_id: String
    def initialize: (SandboxRequests requests, String session_id) -> void
    private def request: (Symbol operation, Hash[Symbol, json_value] body) -> SandboxRequest
  end
end
